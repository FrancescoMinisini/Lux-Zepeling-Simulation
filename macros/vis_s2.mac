/control/verbose 2
/run/verbose 2
/event/verbose 0
/tracking/verbose 0
/process/optical/verbose 0
/process/optical/scintillation/verbose 0

# Open Qt viewer (fallback to OGL if Qt not available)
 /vis/open OGLSQt 800x800-0+0

# Set viewpoint (side view)
 /vis/viewer/set/viewpointThetaPhi 90 0

# Draw geometry
 /vis/drawVolume

# Add smooth trajectories
 /vis/scene/add/trajectories smooth

# Color tracks
 /vis/modeling/trajectories/create/drawByParticleID
 /vis/modeling/trajectories/drawByParticleID-0/set e- red
 /vis/modeling/trajectories/drawByParticleID-0/set opticalphoton green

# Accumulate tracks
 /vis/scene/endOfEventAction accumulate
 /vis/scene/endOfRunAction accumulate

# Initialize
 /run/initialize

# Run events for vis
 /run/beamOn 1