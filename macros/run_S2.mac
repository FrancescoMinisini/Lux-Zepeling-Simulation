/control/verbose 2
/run/verbose 2
/event/verbose 2
/tracking/verbose 2
/process/optical/verbose 2  # Debug optical processes (scint, absorption, etc.)
/process/optical/scintillation/verbose 1
/run/numberOfThreads 1
/analysis/setDefaultFileType csv
/analysis/setFileName ../outputs/lz_s2
/run/initialize
/run/beamOn 1