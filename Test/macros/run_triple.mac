# Triple NR events (tre primari nello stesso evento, tempi diversi)
/control/execute common_batch.mac

# Nome file dedicato alla classe "triple"
/analysis/setFileName wimp_triple

# Assicurati che in SimConfig:
#   gen.event_category = 3  (Triple)
#   (es. tempi 0 ns, 50 ns, 120 ns impostati nel generator)
/run/beamOn 5000
