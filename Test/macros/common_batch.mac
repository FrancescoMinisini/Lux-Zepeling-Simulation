# -------- Common batch settings --------
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/verbose 0

# (Opzionale) multi-threading: imposta il numero di thread se la build è MT
# /run/numberOfThreads 4

# Disabilita la visualizzazione in batch
/vis/disable

# Random seed riproducibile (cambia le coppie per nuovi dataset)
/random/setSeeds 123456 789012

# Inizializza il run
/run/initialize

# (Opzionale) tagga il file di output; il codice imposta "wimp_datasets" come base.
# Qui aggiungiamo un suffisso per categoria in ciascuna macro specifica con /analysis/setFileName
